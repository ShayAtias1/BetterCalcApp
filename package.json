{
  "name": "bettercalc-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/fix-exceljs-sheet-properties.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "licenses:generate": "node scripts/generate-licenses.mjs",
    "release:check": "node scripts/early-access-preflight.mjs",
    "lint": "oxlint",
    "test": "node --experimental-test-module-mocks --import ./tests/resolve-ts.mjs --import ./tests/browser-stubs.mjs --test 'tests/**/*.test.ts' 'tests/**/*.test.mjs'",
    "preview": "vite preview",
    "demo:smoke": "node demo/smoke.mjs",
    "demo:qto": "node demo/qto-demo.mjs",
    "demo:compare": "node demo/compare-demo.mjs",
    "dev:ai": "node --env-file-if-exists=.env.ai.local server/ai-server.mjs"
  },
  "dependencies": {
    "@embedpdf/pdfium": "2.15.1",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource/assistant": "^5.3.0",
    "@fontsource/noto-sans-hebrew": "^5.3.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@supabase/supabase-js": "^2.118.0",
    "bidi-js": "^1.1.0",
    "exceljs": "^4.4.0",
    "fflate": "^0.8.3",
    "file-saver": "^2.0.5",
    "idb": "^8.0.3",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "polygon-clipping": "^0.15.7",
    "posthog-js": "^1.434.17",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "uuid": "^14.0.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^6.0.3",
    "fake-indexeddb": "^6.2.5",
    "oxlint": "^1.71.0",
    "playwright": "^1.63.0",
    "supabase": "^2.121.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  }
}

# Copy to .env.local (git-ignored) or set in the hosting provider's build environment.
# Analytics stays off unless BOTH PostHog values are set — and it is always off in `npm run dev`.
# See docs/ANALYTICS.md.

# PostHog project API key (the public "phc_…" key; it can only write events).
VITE_POSTHOG_KEY=
# PostHog ingestion host for the project's region, e.g. https://eu.i.posthog.com
VITE_POSTHOG_HOST=

# Set to true to log analytics events to the browser console instead of sending them (works in dev).
# VITE_ANALYTICS_DEBUG=true

# Optional: overrides the git SHA used as `app_version` (hosts without a .git checkout can set it).
# Vercel, Cloudflare Pages, Netlify and GitHub Actions commit variables are picked up automatically.
# APP_VERSION=

# Supabase accounts (optional; the app is fully local without them). See docs/SUPABASE-SETUP.md.
# Only the project URL and the PUBLISHABLE key belong here: Vite embeds every VITE_ value in the
# public bundle. NEVER put a secret key (sb_secret_…) or the legacy service_role key in any VITE_
# variable — the app refuses to start the client if it detects one.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Turnstile PUBLIC site key; unused while CAPTCHA_ENABLED is false in src/lib/supabase/captcha.ts.
VITE_TURNSTILE_SITE_KEY=

# LOCAL AI SERVICE ONLY: put these in .env.ai.local (gitignored), not any VITE_ variable.
# npm run dev:ai loads .env.ai.local. No API key is needed in the frontend environment.
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
AI_PORT=4781
AI_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
AI_MAX_REQUESTS=20
AI_SPEND_LIMIT_USD=20

# Dev only: show the live AI detection tools in the AI menu (calls the local AI proxy). Off = locked rows, as in production.
# VITE_AI_DEV_TOOLS=true
